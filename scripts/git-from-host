#!/bin/sh
# Import host git identity so commits are not ubuntu@<container>.
#
# SSH keys authenticate push/pull. They do not set user.name / user.email.
# Git looks at config / GIT_AUTHOR_* / then the Linux account (uid 1000
# is "ubuntu", not your GitHub name).
#
# Same idea as ssh-from-host: bind the host file once, type `git commit`.
# Do not bake a name into the image.
#
# Sources (first that has user.name or user.email):
#   $GIT_CONFIG_FILE
#   $HOME/.gitconfig
#   bind-mount whose target ends in .gitconfig
#   sibling of an .ssh bind (Compose ~/.ssh:/${USER}/.ssh:ro →
#     /cartago/.ssh; ~/.gitconfig:/${USER}/.gitconfig:ro →
#     /cartago/.gitconfig)
#   /root/.gitconfig, /home/*/.gitconfig, /*/.gitconfig (host USER)
#
# GIT_AUTHOR_NAME + GIT_AUTHOR_EMAIL (Compose `environment:`) win over
# a file. Those are written into the generated config so `git config
# user.name` matches the commit.
#
# Writes /tmp/container-git-<uid>/config and env (GIT_CONFIG_GLOBAL).
# git-wrap sources env. Host commit.gpgsign is NOT copied (no keyring).
set -eu

log() {
  if [ "${GIT_FROM_HOST_VERBOSE:-}" = 1 ]; then
    echo "git-from-host: $*" >&2
  fi
}

uid=$(id -u)
dest="${GIT_FROM_HOST_DEST:-/tmp/container-git-${uid}}"
envf="${dest}/env"
cfg="${dest}/config"
gitbin=/usr/bin/git

get_from_file() {
  _f=$1
  _k=$2
  [ -f "$_f" ] && [ -r "$_f" ] || return 1
  [ -x "$gitbin" ] || return 1
  "$gitbin" config -f "$_f" --get "$_k" 2>/dev/null || return 1
}

file_has_identity() {
  _n=$(get_from_file "$1" user.name) || _n=
  _e=$(get_from_file "$1" user.email) || _e=
  [ -n "$_n" ] || [ -n "$_e" ]
}

try_file() {
  [ -n "${_hit:-}" ] && return 0
  _f=$1
  [ -n "$_f" ] || return 0
  file_has_identity "$_f" || return 0
  _hit=$_f
  return 0
}

pick_src() {
  _hit=
  if [ -n "${GIT_CONFIG_FILE:-}" ]; then
    try_file "$GIT_CONFIG_FILE"
  fi
  try_file "${HOME:-/root}/.gitconfig"
  if [ -z "${_hit:-}" ] && [ -r /proc/self/mountinfo ]; then
    exec 3< /proc/self/mountinfo
    while read -r _id _par _dev _root mnt _rest <&3; do
      case "$mnt" in
        *.gitconfig|*/.gitconfig)
          try_file "$mnt"
          if [ -n "${_hit:-}" ]; then
            break
          fi
          ;;
        *.ssh|*/.ssh)
          try_file "$(dirname "$mnt")/.gitconfig"
          if [ -n "${_hit:-}" ]; then
            break
          fi
          ;;
      esac
    done
    exec 3<&-
  fi
  if [ -z "${_hit:-}" ]; then
    try_file /root/.gitconfig
  fi
  if [ -z "${_hit:-}" ]; then
    for _f in /home/*/.gitconfig; do
      [ -f "$_f" ] || continue
      try_file "$_f"
      [ -n "${_hit:-}" ] && break
    done
  fi
  if [ -z "${_hit:-}" ]; then
    for _top in /*; do
      [ -d "$_top" ] || continue
      case "$_top" in
        /proc|/sys|/dev|/run|/tmp|/mnt|/media|/opt|/usr|/var|/boot|/snap|/etc|/lib|/lib32|/lib64|/bin|/sbin|/root|/home|/lost+found)
          continue
          ;;
      esac
      try_file "${_top}/.gitconfig"
      [ -n "${_hit:-}" ] && break
    done
  fi
  [ -n "${_hit:-}" ] || return 1
  printf '%s\n' "$_hit"
}

name=${GIT_AUTHOR_NAME:-}
email=${GIT_AUTHOR_EMAIL:-}
src=
if [ -z "$name" ] || [ -z "$email" ]; then
  src=$(pick_src) || src=
  if [ -n "$src" ]; then
    [ -n "$name" ] || name=$(get_from_file "$src" user.name) || name=
    [ -n "$email" ] || email=$(get_from_file "$src" user.email) || email=
  fi
fi

mkdir -p "$dest"
chmod 700 "$dest" 2>/dev/null || true

# Always emit a global config. user.useConfigOnly stops git inventing
# ubuntu@<container-id> when name/email are missing.
{
  echo "# generated by git-from-host — do not edit"
  echo "[user]"
  echo "  useConfigOnly = true"
  if [ -n "$name" ]; then
    printf '  name = %s\n' "$name"
  fi
  if [ -n "$email" ]; then
    printf '  email = %s\n' "$email"
  fi
  echo "[safe]"
  echo "  directory = *"
} >"$cfg"
chmod 644 "$cfg"

{
  echo "GIT_CONFIG_GLOBAL=${cfg}"
  echo "export GIT_CONFIG_GLOBAL"
  if [ -n "$name" ] && [ -n "$email" ]; then
    echo "CONTAINER_GIT_IDENTITY=ok"
  else
    echo "CONTAINER_GIT_IDENTITY=missing"
  fi
  echo "export CONTAINER_GIT_IDENTITY"
} >"$envf"
chmod 600 "$envf"

if [ -n "$name" ] && [ -n "$email" ]; then
  log "identity from ${src:-GIT_AUTHOR_*} -> $cfg ($name <$email>)"
else
  log "no host git identity (bind any …/.gitconfig, e.g. ~/.gitconfig:/\${USER}/.gitconfig:ro, or set GIT_AUTHOR_NAME + GIT_AUTHOR_EMAIL)"
fi
exit 0
