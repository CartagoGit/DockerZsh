#!/bin/sh
# Catalogue of what cartagodocker/zsh ships. English on purpose:
# this is the image's own --help, not a host docker CLI.
set -eu

usage() {
  cat <<'EOF'
cartagodocker/zsh — Ubuntu 24.04 LTS + zsh + Oh My Zsh + Powerlevel10k.

This command is the image catalogue. It is not `docker` on the host.
Run it inside a running container:

  dockerzsh
  dockerzsh --help | -h
  dockerzsh --version | -v
  dockerzsh --sections
  dockerzsh --shells
  dockerzsh shells network

##id:about
========================================================================
What this image is
========================================================================

A shell base for interactive work and for child images (for example
cartagodocker/nodebun). Root, uid 1000 (ubuntu), and later `useradd -m`
users share the same .zshrc, .p10k.zsh, and Oh My Zsh via
/usr/share/globally (symlinked into each home and /etc/skel).

There is no ENTRYPOINT. CMD is /usr/bin/zsh. Whatever you pass to
`docker run` / Compose `command:` is the process that actually runs.

Two different jobs — mixing them looks like "eza is broken":

  Interactive prompt (eza, bat, p10k, aliases)
    docker run --rm -it cartagodocker/zsh
    docker exec -it <container> zsh
    docker compose exec <svc> zsh
    docker compose exec <svc> bash   # ls→eza, zoxide, fzf (no p10k)
    docker compose exec <svc> sh     # ls→eza, zoxide (no fzf keys, no p10k)

  Keep-alive (Compose)
    command: ["tail", "-f", "/dev/null"]
    That process is tail, not a shell, and not a TTY. No prompt, no
    aliases. Attach later with: docker compose exec <svc> zsh
    (or bash / sh for a simpler interactive shell)

Build SHELL is ["/bin/sh", "-c"] so child Dockerfiles do not inherit
zsh -c for RUN. Locale is LANG=C.UTF-8 / LC_ALL=C.UTF-8.
HTTPS works: ca-certificates is installed.
No sshd. No Docker inside (no dockerd, no docker CLI). Attach with
docker exec from the host. Install a Docker client in a child image
if you need one.

##id:usage
========================================================================
Usage
========================================================================

  dockerzsh                 Same as --help (this catalogue)
  dockerzsh --help | -h     This text
  dockerzsh --version | -v  Image identity only (ZSH_IMAGE_VERSION)
  dockerzsh --list | -l     Tool names from the catalogue (discovered, not hardcoded)
  dockerzsh --list --version | -l -v
                            Probe every catalogue tool now
  dockerzsh shells --version | shells -v
                            Tools in one section (any section id)
  dockerzsh eza --version | eza -v
                            One tool (PATH + --version / -V / dpkg)
  dockerzsh --sections | -s List section ids
  dockerzsh --shells        One section (also: dockerzsh shells)
  dockerzsh --plugins       Oh My Zsh plugins (interactive zsh)
  dockerzsh shells network  Several sections

  Section ids: about usage shells plugins listing edit archives
               network system extras helpers fonts

EOF
  tools
}

tools() {
  cat <<'EOF'
##id:shells
========================================================================
Shells
========================================================================

  zsh
      Default interactive shell. Oh My Zsh + Powerlevel10k. This is
      CMD. Prompt and plugins load only in an interactive zsh TTY —
      not under `tail -f /dev/null`. Aliases (ls→eza, cat→bat) also
      load in interactive bash and sh (shared snippet). Tab is native
      completion. Typing suggests via zsh-autosuggestions (cyan ghost;
      → or End to accept). Up / Down match the typed prefix
      (history-substring-search). Ctrl-R is fzf. Plugin list:
      dockerzsh --plugins. docker --rm history starts empty.

  bash
      GNU bash. Use `docker run IMAGE bash`, `docker compose exec svc
      bash`, or type `bash` inside zsh. Interactive bash: ls→eza,
      cat→bat, zoxide, fzf keys, bash-completion (Tab), ble.sh
      ghost-text (type `ec` → suggests echo), green/red ❯ from the
      last exit code. Non-interactive `bash -c` does not.

  sh
      POSIX sh (dash on Ubuntu). Use for portable snippets. Interactive
      `sh` sources $ENV (ls→eza, zoxide). Login `sh -l` also sources
      profile.d. `sh -c` / Dockerfile RUN stay alias-free.

##id:plugins
========================================================================
Oh My Zsh plugins (interactive zsh only)
========================================================================

  These load from ~/.zshrc. They do not apply to bash, sh, or
  `docker run IMAGE cmd`. Tab is native completion (not fzf).
  Powerlevel10k and zoxide are unchanged.

  git
      Aliases: gst, gco, gd, gl, gp, gcb, …  (Oh My Zsh git plugin)

  extract / x
      Pick unzip/tar/zstd from the file extension.

  sudo
      ESC ESC prefixes the current / previous command with sudo.

  jsontools
      pp_json, is_json, urlencode_json, urldecode_json.
      OMZ uses node/python3/ruby when present (NodeBun). This base
      has jq only — same names, jq implementation.

  zsh-autosuggestions
      Ghost text as you type (history, then completion). → or End
      accepts. Cyan on p10k.

  zsh-completions
      Extra completion functions on fpath before compinit.

  zsh-syntax-highlighting
      Green / red while you type. Loaded before history-substring-search.

  zsh-history-substring-search
      Up / Down walk history that starts with what you already typed.
      Ctrl-R is still fzf. Bindings are after fzf key-bindings.

  you-should-use
      Reminds you of an alias (gst) when you type the long form.

  safe-paste
      A multi-line paste is not executed until you press Enter.

  fancy-ctrl-z
      Ctrl-Z backgrounds the editor and brings it back.

  dirhistory
      Alt-Left / Alt-Right walk the directory stack. Complements z.

  zsh-bat
      cat → bat in zsh. Interactive bash/sh get the same alias from
      /usr/share/zsh-image/interactive.sh.

  Not loaded: vscode (no `code` in the image), fasd (no binary),
  fzf-tab / zsh-autocomplete (would steal Tab).

##id:listing
========================================================================
Listing / viewing (upgrades of ls / cat / find / grep)
========================================================================

  eza
      Modern ls: colours, git status, icons (needs a Nerd Font on the
      HOST). Aliased as `ls` in interactive zsh, bash, and sh. GNU ls
      remains `/usr/bin/ls` if you need it (scripts / `sh -c`).

      eza -la                  long + hidden
      eza --tree --level=2     tree view
      ls                       same as eza (interactive alias)

  bat
      Syntax-highlighting cat. Debian package name is batcat; this
      image puts /usr/local/bin/bat → batcat so `bat file` works.
      Interactive zsh/bash/sh alias `cat` → `bat --paging=never`.
      GNU cat is `rcat` or `/usr/bin/cat`.

      bat README.md
      cat README.md            same colours, no pager
      bat -n Dockerfile        with line numbers

  fd
      Fast find (Debian name fdfind). GNU find stays as `find`.

      fd Dockerfile
      fd -e zsh scripts        only .zsh files under scripts/

  rg  (ripgrep)
      Fast recursive grep. Ignores .gitignore by default.

      rg 'NOPASSWD' /etc/sudoers.d
      rg -n TODO .

  less
      Pager. git log / git diff use this. q to quit.

  tree
      Print a directory tree. eza --tree is the colour alternative.

  nnn
      Terminal file manager. Arrow keys / hjkl; q to quit.

  ncdu
      Interactive disk usage (du with a TUI). Walk a bind-mounted
      project when the image is unexpectedly large.

  duf
      Colourful df: filesystems, sizes, mount points.

##id:edit
========================================================================
Edit / data
========================================================================

  nano
      Small terminal editor. Ctrl+O save, Ctrl+X quit.

  vi
      vim-tiny. Enough for scripts that call `vi` / `$EDITOR`. Not
      neovim (put that in a child image).

  jq
      Query / transform JSON on stdin or files.

      echo '{"a":1}' | jq .a

  jo
      Build JSON from arguments (the inverse of jq for simple objects).

      jo name=app version=1.0

  sqlite3
      Command-line SQLite. Open a .db and run SQL.

  hexdump / xxd
      Dump file bytes. xxd also reverses dumps (`xxd -r`).

  bc
      Arbitrary-precision calculator.

      echo '2^10' | bc

  column
      Align columns (bsdextrautils). Pipe TSV/CSV-ish text through it.

##id:archives
========================================================================
Archives / text conversion
========================================================================

  unzip / zip
      zip archives. unzip is required by many installers.

  tar / gzip
      Already in Ubuntu. tar -xzf archive.tar.gz, etc.

  xz / bzip2 / zstd / lz4 / pigz / cpio
      Extra compressors. pigz is parallel gzip. cpio for initramfs /
      rpm-style archives.

  cabextract
      Extract .cab (Windows cabinet) files.

  extract / x
      Oh My Zsh helper: picks unzip/tar/zstd/… from the file extension.

      extract archive.tar.xz

  uchardet
      Detect text encoding (UTF-8 vs Latin-1 vs Windows-1252).

  dos2unix
      CRLF → LF. Handy on bind mounts from Windows hosts.

##id:network
========================================================================
Network
========================================================================

  curl / wget
      HTTP(S) download. ca-certificates is installed so https:// works.

  ssh / scp / sftp
      OpenSSH **client** only — there is no sshd in this image.
      Bind-mount host keys and type `ssh`. Destination can be any
      absolute path ending in .ssh (not only $HOME). Usual example:

        volumes:
          - ~/.ssh:/${USER}/.ssh:ro
        # or another folder: ~/.ssh:/mnt/host-ssh:ro

      Docker needs the leading / (${USER} is the host name). The
      wrapper finds that bind, copies keys into a 700 dir this uid
      owns, and works as root or any other user.

      known_hosts — two layers; bringing the host file is optional:
        1. Official GitHub/GitLab keys baked in the image:
           /usr/share/ssh/known_hosts and /etc/ssh/ssh_known_hosts
           (GlobalKnownHostsFile). Same file twice so /usr/bin/ssh
           still trusts them if someone bypasses the wrapper.
        2. If the bind includes known_hosts, it is copied to
           /tmp/container-ssh-<uid>/known_hosts (writable). New hosts
           from StrictHostKeyChecking=accept-new are appended THERE,
           never on the :ro volume. Re-runs merge host lines and
           keep container-learned hosts. Without a host file, the
           baked keys still cover github.com / gitlab.com.

      docker run -v ~/.ssh:/$USER/.ssh:ro \
                 -v ~/.gitconfig:/$USER/.gitconfig:ro -it IMAGE
      ssh git@github.com
      git commit

      No keys and no SSH_AUTH_SOCK: ssh-wrap says keys are required
      (example bind + “any folder ending in .ssh”), then OpenSSH
      still runs (its own error).

  ssh-from-host
      Copy host keys now (also runs from zshrc / profile.d / ssh).
      SSH_FROM_HOST_VERBOSE=1 to see the copy. You do not need to
      call this yourself.

  ping
      ICMP ping. Often needs NET_RAW or --cap-add NET_RAW.

  tracepath
      Path MTU discovery without root.

  fping
      Fast multi-host ping.

  whois
      WHOIS for domains / IPs.

  mtr
      traceroute + ping in one TUI (mtr-tiny).

  traceroute
      Classic traceroute.

  rsync
      Copy directory trees over ssh or locally.

      rsync -a /work/ user@host:/backup/

  nc
      netcat (netcat-openbsd). TCP/UDP swiss army knife.

  socat
      Bidirectional relay — more than nc (unix sockets, TLS, exec).

  ip / ss
      iproute2: addresses, routes, sockets. `ss -lntp` instead of netstat.
      Container IP: `ip -4 addr`. DNS in use: `cat /etc/resolv.conf`.
      Resolve a name with the same resolver as curl/git:
      `getent hosts github.com` (no dig in this image).

  openssl
      TLS, certs, digests. `openssl s_client -connect host:443`.

  tcpdump
      Packet capture. Usually needs NET_RAW / NET_ADMIN (or host net).

  htpasswd / ab
      apache2-utils: write basic-auth files; tiny HTTP benchmark (ab).

##id:system
========================================================================
System / git / process
========================================================================

  git / tig
      Version control + git TUI (tig). HTTPS remotes work
      (ca-certificates). SSH remotes: mount ~/.ssh and type git
      (GIT_SSH_COMMAND uses the same ssh wrapper).

      Commits need user.name + user.email. The SSH key does not
      provide them. The image does not bake a name. Same contract
      as ssh: bind the host file once (or set GIT_AUTHOR_NAME +
      GIT_AUTHOR_EMAIL). Destination can be any absolute path
      ending in .gitconfig. git-from-host writes a tiny global
      config under /tmp/container-git-<uid>/; git-wrap loads it.
      Without an identity, `git commit` says identity is required
      (example + other-folder) and exits 1 (no ubuntu@<container>).

        volumes:
          - ~/.ssh:/${USER}/.ssh:ro
          - ~/.gitconfig:/${USER}/.gitconfig:ro
        # or: ~/.gitconfig:/mnt/host-gitconfig:ro

      git config user.name     # should match the host
      git commit               # author is that name, not ubuntu@id

  git-from-host
      Copy host identity now (also from zshrc / profile.d / git).
      GIT_FROM_HOST_VERBOSE=1 to see the path. You do not need to
      call this yourself.

  make
      GNU make. There is no gcc/g++ in this image — Makefiles that
      only run scripts/docker are fine; compiling C needs a child image.

  envsubst
      Expand $VARS in files (gettext-base). Typical: templates → env.

  htop
      Interactive process viewer. `top` is already in Ubuntu.

  lsof
      List open files / sockets. `lsof -i :3000`.

  killall
      Kill by name (psmisc). Also: pstree, fuser.

  pv
      Pipe progress (bytes through a pipeline).

      tar -c dir | pv | gzip > dir.tar.gz

  sponge
      moreutils: write a file only after stdin ends. Safe in-place
      filter: `jq . file.json | sponge file.json`.

  uuidgen
      Generate UUIDs.

  getfacl / setfacl
      POSIX ACLs on files.

  getcap / setcap
      File capabilities (libcap2-bin).

  inotifywait
      Watch files for changes (inotify-tools).

  entr
      Run a command when files change. `ls *.c | entr make`.

  strace
      Trace syscalls (why a process hangs or fails).

  progress
      Show progress of an already-running cp/mv/dd.

  tmux
      Terminal multiplexer. Attach inside a keep-alive container
      so a session survives `docker compose exec` disconnects.

  keychain
      ssh-agent helper: reuse an agent across shells.

  sudo
      Passwordless by default: ALL ALL=(ALL:ALL) NOPASSWD:ALL.
      Compose `user: "1000:1000"` drops extra groups, so the rule is
      ALL, not %sudo. Global configs are 644 root:root; uid 1000
      cannot overwrite them directly — use sudo or the helpers below.

      sudo -n id               # default: no password
      sudo-password            # start requiring one
      sudo-nopasswd            # back to NOPASSWD

##id:extras
========================================================================
Extras (fuzzy find, cd, diffs)
========================================================================

  fzf
      Fuzzy finder. Interactive zsh and bash source Ubuntu's
      key-bindings + completion under /usr/share/doc/fzf/examples/
      (kept despite Ubuntu's Docker dpkg doc-exclude). Ctrl-R history,
      Ctrl-T files, Alt-C cd. dash has no fzf keys. The binary also
      works as a pipe filter in any shell.

      fd | fzf
      git log --oneline | fzf

  zoxide
      Smarter cd; command is `z`. Learns directories you visit.
      Interactive zsh / bash / sh run `zoxide init`.

      z dockerzsh              jump to a known path fragment

  colordiff
      Colourful diff. `colordiff -u a b`.

  patch
      Apply unified diffs. `patch -p1 < fix.diff`.

##id:helpers
========================================================================
Image helpers (this image — not Ubuntu packages)
========================================================================

  add_text_to_zshrc <text> [--prepend]
      Append (default) or prepend text to the shared
      /usr/share/globally/.zshrc. Every user (root, uid 1000, new
      useradd -m) sees it. Escalates with NOPASSWD sudo when the
      file is 644 root:root. --prepend may appear in any position.

      add_text_to_zshrc "alias hello='echo hi'"
      add_text_to_zshrc "alias hello='echo hi'" --prepend
      add_text_to_zshrc "$(printf '%s\n' 'line1' 'line2')"

  add_text_to_p10k <text> [--prepend]
      Same contract as add_text_to_zshrc, writes
      /usr/share/globally/.p10k.zsh.

      add_text_to_p10k "typeset -g POWERLEVEL9K_INSTANT_PROMPT=verbose"

  share_config_globally <src> [--to <name>] [--base-src <root>] [--permissions <octal>]
      Move a file/dir from a user home (default /root) to /usr/share
      and symlink it into every existing home + /etc/skel. Child
      images use this for fnm/bun stores.

      share_config_globally .local/share/fnm
      share_config_globally .oh-my-zsh --to globally/.oh-my-zsh --permissions 755

  sudo-password [secret]
      Require (or change) a sudo password at runtime — not baked
      into the image. No arg + TTY: hidden prompt. Or pass the
      secret as arg (visible in `ps`) or SUDO_PASSWORD=secret
      sudo-password. Writes /etc/container-sudo-password, switches
      sudoers to require a password, chpasswd on login users.
      First time (NOPASSWD): escalates with sudo -n. Later change:
      sudo asks for the *current* password, then the helper sets
      the new one. Also: docker run -e SUDO_PASSWORD=secret IMAGE
      (first shell via apply-sudo-password-on-boot.sh).

  sudo-nopasswd
      Drop the optional password and restore NOPASSWD (image default).
      Needs root, passwordless sudo, or sudo with the current password.

  git-from-host
      Import host user.name / user.email (also from zshrc / git).
      Bind any …/.gitconfig (example: ~/.gitconfig:/${USER}/.gitconfig:ro).
      Verbose: GIT_FROM_HOST_VERBOSE=1.

  dockerzsh
      This catalogue.

##id:fonts
========================================================================
Fonts, locale, what is NOT in this image
========================================================================

Locale: LANG=C.UTF-8. HTTPS: ca-certificates is installed.
The container only emits Unicode; the HOST terminal draws glyphs.

  Prompt whale (os_icon, 🐳)  -> emoji font on the host
                                     (Noto Color Emoji / Segoe UI Emoji / Apple)
  Powerline / eza icons            -> Nerd Font on the host
                                     (Cascadia Code NF / CaskaydiaCove)

Without a Nerd Font you get boxes on the prompt / ls icons. That is
not an image bug.

Not in this image (use a child image): gcc/g++/python3, neovim, git-lfs,
rclone, locales, man-db, nmap, file, 7zip, xmllint, git-extras, gpg,
expect/tcl, dig/nslookup (bind9-dnsutils), iperf3, rlwrap. No sshd.
No Docker (dockerd / docker CLI). tcpdump often needs extra Linux
capabilities (NET_RAW / NET_ADMIN / host network). DNS of this
container: /etc/resolv.conf + `getent hosts`.

Size (order of magnitude, amd64): ubuntu:24.04 ~78 MB disk / ~28 MB Hub.
zsh v1.0.5 ~205 MB disk / ~76 MB Hub. v2.0.0 ~249 MB disk.
docker images = disk; Hub pull = gzip layers.
EOF
}

version() {
  # Image identity only. Tool versions: dockerzsh list --version
  echo "cartagodocker/zsh  VERSION=${ZSH_IMAGE_VERSION:-${VERSION:-}}  SHELL=${SHELL:-/usr/bin/zsh}  LANG=${LANG:-}"
}

# Tool names come from catalogue headings (the `  eza` / `  unzip / zip`
# lines). Adding a package to the Dockerfile + a heading here is enough;
# this probe list is not maintained by hand.
extract_tools() {
  want=${1:-}
  catalogue | awk -v want="$want" '
    BEGIN {
      skip["about"] = 1
      skip["usage"] = 1
      skip["helpers"] = 1
      skip["fonts"] = 1
      skip["plugins"] = 1
      # Oh My Zsh functions / image helpers, not versioned PATH binaries.
      skipcmd["extract"] = 1
      skipcmd["x"] = 1
      skipcmd["ssh-from-host"] = 1
      skipcmd["git-from-host"] = 1
    }
    /^##id:/ {
      cur = substr($0, 6)
      next
    }
    cur == "" { next }
    cur in skip { next }
    want != "" && cur != want { next }
    /^  [A-Za-z0-9]/ {
      line = $0
      sub(/^  /, "", line)
      gsub(/\([^)]*\)/, "", line)
      n = split(line, parts, "/")
      for (i = 1; i <= n; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[i])
        split(parts[i], w, /[[:space:]]+/)
        cmd = w[1]
        if (cmd ~ /^[A-Za-z0-9][A-Za-z0-9._+-]*$/ && !(cmd in skipcmd) && !seen[cmd]++) {
          print cmd
        }
      }
    }
  '
}

is_section_id() {
  case "$1" in
    about|usage|shells|plugins|listing|edit|archives|network|system|extras|helpers|fonts)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

probe_cmd() {
  _cmd=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout 1 "$_cmd" "$@" 2>&1 || true
  else
    "$_cmd" "$@" 2>&1 || true
  fi
}

print_tool_version() {
  name=$1
  if ! command -v "$name" >/dev/null 2>&1; then
    printf '  %-14s  (not on PATH)\n' "$name"
    return 0
  fi
  text=
  # Scan every line: eza --version prints the tag on line 2, and
  # `eza version` is a path (not a flag). Skip error lines that
  # happen to contain a digit.
  for try in --version -V version; do
    line=$(probe_cmd "$name" "$try" | tr -d '\r' | grep -v '^$' | grep '[0-9]' | grep -viE 'no such file|unknown option|illegal option|os error' | head -n 1)
    if [ -n "$line" ]; then
      text=$line
      break
    fi
  done
  if [ -z "$text" ]; then
    bin=$(command -v "$name")
    real=$(readlink -f "$bin" 2>/dev/null || printf '%s' "$bin")
    pkg=$(dpkg-query -S "$real" 2>/dev/null | head -n 1 | cut -d: -f1)
    if [ -n "$pkg" ]; then
      ver=$(dpkg-query -W -f '${Version}' "$pkg" 2>/dev/null || true)
      if [ -n "$ver" ]; then
        text="$pkg ${ver}"
      fi
    fi
  fi
  if [ -z "$text" ]; then
    text='(no --version)'
  fi
  printf '  %-14s  %s\n' "$name" "$text"
}

show_tool_versions() {
  if [ $# -eq 0 ]; then
    extract_tools | while IFS= read -r n; do
      print_tool_version "$n"
    done
    return 0
  fi
  for raw in "$@"; do
    id=$(normalize_id "$raw")
    if [ "$id" = "list" ]; then
      extract_tools | while IFS= read -r n; do
        print_tool_version "$n"
      done
    elif is_section_id "$id"; then
      echo "${id}:"
      extract_tools "$id" | while IFS= read -r n; do
        print_tool_version "$n"
      done
    else
      print_tool_version "$raw"
    fi
  done
}

# Markers ##id:<name> sit on their own line before each section title.
# They are stripped from output. --shells / shells / --section shells
# all mean the same thing. Several ids: dockerzsh shells network
normalize_id() {
  id=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  while [ "${id#-}" != "$id" ]; do
    id=${id#-}
  done
  case "$id" in
    help|h) id=help ;;
    version|v) id=version ;;
    sections|s) id=sections ;;
    section) id=section ;;
    ls|view|viewing) id=listing ;;
    list|l|tools) id=list ;;
    data) id=edit ;;
    archive) id=archives ;;
    net) id=network ;;
    process) id=system ;;
    extra) id=extras ;;
    plugin|omz|ohmyzsh) id=plugins ;;
    helper) id=helpers ;;
    font|locale|missing) id=fonts ;;
    image) id=about ;;
  esac
  printf '%s' "$id"
}

catalogue() {
  usage
}

strip_ids() {
  grep -v '^##id:'
}

list_sections() {
  catalogue | awk '
    /^##id:/ { id = substr($0, 6); next }
    id != "" && $0 != "" && $0 !~ /^=+$/ {
      printf "  %-12s %s\n", id, $0
      id = ""
    }
  '
}

show_sections() {
  want=
  for raw in "$@"; do
    id=$(normalize_id "$raw")
    want="${want}${want:+ }${id}"
  done
  catalogue | awk -v want="$want" '
    BEGIN {
      n = split(want, w, " ")
      for (i = 1; i <= n; i++) ids[w[i]] = 1
    }
    /^##id:/ {
      cur = substr($0, 6)
      show = (cur in ids)
      next
    }
    show { print }
  '
}

unknown_section() {
  echo "dockerzsh: unknown section: $1" >&2
  echo "Try: dockerzsh --sections | -s" >&2
  echo "     dockerzsh --help | -h" >&2
  echo "     dockerzsh --list --version | -l -v" >&2
  exit 2
}

# First token may be --shells, shells, --section, or a bare id.
if [ $# -eq 0 ]; then
  catalogue | strip_ids
  exit 0
fi

# --version / -v as the first token is image identity, not a tool probe.
cmd=$(normalize_id "$1")
if [ "$cmd" = "version" ]; then
  version
  exit 0
fi
if [ "$cmd" = "help" ]; then
  catalogue | strip_ids
  exit 0
fi
if [ "$cmd" = "sections" ]; then
  echo "dockerzsh sections (dockerzsh --shells, dockerzsh shells, dockerzsh --section shells, dockerzsh -s):"
  list_sections
  exit 0
fi

want_tool_ver=0
filtered=
for raw in "$@"; do
  nid=$(normalize_id "$raw")
  if [ "$nid" = "version" ]; then
    want_tool_ver=1
  else
    filtered="${filtered}${filtered:+ }${raw}"
  fi
done

if [ "$want_tool_ver" = 1 ]; then
  # shellcheck disable=SC2086
  set -- $filtered
  show_tool_versions "$@"
  exit 0
fi

if [ "$cmd" = "list" ]; then
  extract_tools
  exit 0
fi

shift
case "$cmd" in
  section)
    if [ $# -eq 0 ]; then
      echo "dockerzsh: --section needs an id (try: dockerzsh --sections)" >&2
      exit 2
    fi
    for raw in "$@"; do
      id=$(normalize_id "$raw")
      catalogue | grep -q "^##id:${id}$" || unknown_section "$raw"
    done
    show_sections "$@"
    ;;
  about|usage|shells|plugins|listing|edit|archives|network|system|extras|helpers|fonts)
    set -- "$cmd" "$@"
    for raw in "$@"; do
      id=$(normalize_id "$raw")
      catalogue | grep -q "^##id:${id}$" || unknown_section "$raw"
    done
    show_sections "$@"
    ;;
  *)
    unknown_section "$cmd"
    ;;
esac
