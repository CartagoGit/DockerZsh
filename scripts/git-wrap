#!/bin/sh
# Invisible PATH wrapper for git.
# Loads host user.name / user.email (git-from-host), then execs the
# real binary. Type `git`; do not learn extra paths.
#
# Without an identity git would invent ubuntu@<container>. We always
# set user.useConfigOnly (git-from-host). Commit-class commands then
# fail with a short how-to instead of a silent wrong author.
set -eu
real=/usr/bin/git
if [ ! -x "$real" ]; then
  echo "git-wrap: ${real} not found" >&2
  exit 127
fi
if [ -x /usr/local/bin/git-from-host ]; then
  /usr/local/bin/git-from-host || true
fi
uid=$(id -u)
envf="${GIT_FROM_HOST_DEST:-/tmp/container-git-${uid}}/env"
if [ -r "$envf" ]; then
  # shellcheck disable=SC1090
  . "$envf"
fi

identity_hint() {
  cat <<'EOF' >&2
git-wrap: host git identity is required (user.name + user.email). None found.

  SSH keys authenticate git pull / git push. They do not name commits.
  Bind the host .gitconfig once, or set env. The destination can be
  ANY absolute path that ends in .gitconfig — not only $HOME.

  Example (usual):

    volumes:
      - ~/.gitconfig:/${USER}/.gitconfig:ro

    docker run -v "$HOME/.gitconfig:/$USER/.gitconfig:ro" …

  Same file, other folder:

    volumes:
      - ~/.gitconfig:/mnt/host-gitconfig:ro
      # or: - /opt/dev/.gitconfig:/config/.gitconfig:ro

  The container path must be absolute (leading /). ${USER} is the
  HOST name if you use that example.

  Or without a file:

    environment:
      GIT_AUTHOR_NAME: "Your Name"
      GIT_AUTHOR_EMAIL: you@example.com

  Both name and email are required. Details: dockerzsh --system
EOF
}

git_subcommand() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env|--list-cmds)
        [ $# -ge 2 ] || return 1
        shift 2
        ;;
      --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|-c*)
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        shift
        ;;
      *)
        printf '%s\n' "$1"
        return 0
        ;;
    esac
  done
  [ $# -gt 0 ] || return 1
  printf '%s\n' "$1"
}

needs_identity() {
  case "$1" in
    commit|commit-tree|merge|rebase|cherry-pick|revert|am)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

cli_has_identity() {
  _name=0
  _email=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--config)
        if [ $# -ge 2 ]; then
          case "$2" in
            user.name|user.name=*) _name=1 ;;
            user.email|user.email=*) _email=1 ;;
          esac
          shift 2
          continue
        fi
        ;;
      -cuser.name|*user.name=*) _name=1 ;;
      -cuser.email|*user.email=*) _email=1 ;;
    esac
    shift
  done
  [ "$_name" = 1 ] && [ "$_email" = 1 ]
}

if [ "${CONTAINER_GIT_IDENTITY:-}" != "ok" ]; then
  sub=$(git_subcommand "$@") || sub=
  if needs_identity "$sub" && ! cli_has_identity "$@"; then
    identity_hint
    exit 1
  fi
fi

exec "$real" "$@"
